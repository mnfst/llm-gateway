{
  "name": "manifest-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -f tsconfig.build.tsbuildinfo && nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "lint": "eslint src/",
    "contract:refresh": "node scripts/refresh-phoenix-contract.mjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/datasource.ts",
    "migration:run": "ts-node -T src/database/migrate.ts",
    "migration:run:prod": "node dist/database/migrate.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/datasource.ts --transaction none",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/datasource.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "backfill:message-providers": "ts-node -T src/database/backfills/backfill-message-providers.cli.ts",
    "backfill:message-providers:prod": "node dist/database/backfills/backfill-message-providers.cli.js",
    "backfill:requests": "ts-node -T src/database/backfills/request-backfill.cli.ts",
    "backfill:requests:prod": "node dist/database/backfills/request-backfill.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@better-auth/cimd": "1.7.4",
    "@better-auth/mcp": "1.7.4",
    "@better-auth/oauth-provider": "1.7.4",
    "@better-auth/stripe": "1.7.4",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.4",
    "@sentry/nestjs": "^10.73.0",
    "better-auth": "1.7.4",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "eventsource-parser": "^3.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "manifest-shared": "*",
    "modelparams": "^0.0.57",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "stripe": "^22.6.2",
    "typeorm": "^0.3.0",
    "uuid": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^30.5.1",
    "js-yaml": "^4.3.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main.ts",
      "!instrument.ts",
      "!**/database/migrations/**",
      "!**/database/datasource.ts",
      "!**/database/data-source-definitions.ts",
      "!**/database/migrate.ts",
      "!**/*.module.ts",
      "!**/otlp/interfaces/index.ts",
      "!**/otlp/proto/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
